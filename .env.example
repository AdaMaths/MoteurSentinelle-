# Configuration MoteurSentinelle (Exemple sans secrets)
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,https://moteursentinelle.vercel.app

# SQLite en local, Firestore en production
DATABASE_TYPE=sqlite
DATABASE_PATH=moteursentinelle.db

# Firebase Firestore (utilisé lorsque DATABASE_TYPE=firestore)
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=backend/firebase-service-account.json
# Pour un hébergeur sans fichier de clé, définissez FIREBASE_SERVICE_ACCOUNT_JSON
# avec le contenu JSON du compte de service dans ses variables secrètes.
