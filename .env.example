# Configuration MoteurSentinelle (Exemple sans secrets)
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,https://moteursentinelle.vercel.app

# Base de données persistante (sqlite en local, postgresql en production)
DATABASE_TYPE=sqlite
DATABASE_PATH=moteursentinelle.db

# Directus (optionnel)
DIRECTUS_URL=http://localhost:8055
DIRECTUS_STATIC_TOKEN=token_lecture_seule_fictif
